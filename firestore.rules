rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isReportOwner(reportId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/reports/$(reportId)) && get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)ottomake2026@gmail.com') ||
        (
          exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) &&
          (get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.role == 'Administrator') &&
          get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.status == 'Active'
        )
      );
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Authorized Users Directory (Admin Only for list/write; Users can get their own record)
    match /authorized_users/{userId} {
      allow list: if isAdmin();
      allow get: if isAuthenticated() && (request.auth.uid == userId || (resource != null && resource.data.email == request.auth.token.email) || isAdmin());
      allow create: if isAuthenticated() && (isAdmin() || request.auth.token.email == 'ottomake2026@gmail.com');
      allow update, delete: if isAdmin();
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Health check ping for client connection verification
    match /test/{docId} {
      allow read: if true;
    }

    // Inspection Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Subcollection: Issues
      match /issues/{issueId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isReportOwner(reportId));
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && (!exists(/databases/$(database)/documents/reports/$(reportId)) || isReportOwner(reportId));
        allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isReportOwner(reportId)) && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isReportOwner(reportId));
      }

      // Subcollection: Evidence Photos
      match /photos/{photoId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isReportOwner(reportId));
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && (!exists(/databases/$(database)/documents/reports/$(reportId)) || isReportOwner(reportId));
        allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isReportOwner(reportId)) && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isReportOwner(reportId));
      }
    }
  }
}
